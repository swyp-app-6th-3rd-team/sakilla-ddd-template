# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore 에 있다. 절대 커밋하지 않는다.

# ── 컨테이너 ────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=sakila
TZ=Asia/Seoul

# ── MySQL ──────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=sakila
MYSQL_USER=sakila
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3306

# ── 애플리케이션 ────────────────────────────────────────────
APP_PORT=8080
# local  = Sakila 시드 데이터(9MB) 로드 + SQL 로그 + 콘솔·파일 로깅
# prod   = 마이그레이션만 + 콘솔·파일 로깅
SPRING_PROFILES_ACTIVE=local

# ── 로그 ────────────────────────────────────────────────────
# 로그는 error/warn/info 디렉터리로 나뉘어 도커 볼륨(sakila-log)에 쌓인다.
# 컨테이너를 삭제해도 남는다. 확인 방법은 README 의 "로그 확인" 참조.
LOG_MAX_HISTORY=30
LOG_TOTAL_SIZE_CAP=3GB

# ── JWT ────────────────────────────────────────────────────
# HS256 이므로 최소 256비트(32바이트) 이상이어야 한다.
# 기동 시 길이를 검증하며, 짧으면 애플리케이션이 뜨지 않는다.
# 생성: openssl rand -base64 48
JWT_SECRET_KEY=

# ── OAuth2 ─────────────────────────────────────────────────
# 쓰지 않는 프로바이더는 비워두면 해당 로그인만 비활성화된다.
# Google:  https://console.cloud.google.com/apis/credentials
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# Kakao:   https://developers.kakao.com/console/app
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
# Naver:   https://developers.naver.com/apps
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=

# ── Pinpoint APM (옵트인) ──────────────────────────────────
# 기본은 꺼져 있다. 아래 값들은 에이전트를 붙일 때만 쓰인다.
#
#   # 최초 1회 — 백엔드는 여러 앱이 공유하는 독립 스택이다
#   docker network create pinpoint-net
#   docker compose -f pinpoint/docker-compose.yml up -d
#
#   # 앱에 에이전트 부착
#   docker compose -f docker-compose-prod.yml -f docker-compose-pinpoint.yml --profile app up -d
#
# 에이전트와 collector 는 반드시 같은 3.1.x 여야 한다.
# 3.1.0 부터 span 전송 기본값이 BATCH 이고 이는 3.1.0+ collector 를 요구한다.
# Java 25 를 지원하는 에이전트도 3.1.x 가 처음이다(3.0.x 는 21 까지).
PINPOINT_VERSION=3.1.0

# ServerMap 의 노드 이름. 같은 앱을 여러 대 띄우면 이 값은 동일해야 한다.
PINPOINT_APPLICATION_NAME=sakila-ddd-template

# 인스턴스 식별자. **24자 제한**이며 인스턴스마다 고유해야 한다.
# 스케일아웃 시 하드코딩하면 인스턴스끼리 충돌하므로 호스트명 등으로 분기시킨다.
PINPOINT_AGENT_ID=sakila-01

# 앱이 collector 를 찾는 주소.
#   컨테이너로 띄울 때  → pinpoint-collector (같은 external 네트워크의 서비스명)
#   IDE 로 띄울 때      → 127.0.0.1
PINPOINT_COLLECTOR_HOST=pinpoint-collector

# 샘플링 비율. COUNTING 방식에서 N 건당 1건을 수집한다.
#   1  = 전수 수집 (검증·개발용)
#   20 = 20건 중 1건 (Pinpoint 기본값, 운영용)
PINPOINT_SAMPLING_RATE=20

# Pinpoint Web UI 포트. 앱이 8080 을 쓰므로 기본값을 8090 으로 둔다.
PINPOINT_WEB_PORT=8090
PINPOINT_ADMIN_PASSWORD=admin

# Pinpoint 자체 메타데이터 DB (트레이스 데이터가 아니다 — 그건 HBase 에 있다)
PINPOINT_MYSQL_USER=admin
PINPOINT_MYSQL_PASSWORD=admin
PINPOINT_MYSQL_ROOT_PASSWORD=pinpoint-root

# HBase 힙.
#
# 이미지 기본값은 hbase-env.sh 의 HBASE_HEAPSIZE 가 주석 처리돼 있어 JVM 기본 힙이다.
# 명시해두는 편이 낫지만, 이 값만으로 초기화 실패가 해결되지는 않는다.
#
# ⚠ 알려진 문제 — Apple Silicon(arm64)에서 초기화가 완주하지 못한다.
# Pinpoint 이미지는 amd64 전용이라 에뮬레이션으로 도는데, TraceV2 테이블
# (리전을 다수로 pre-split, 워커 스레드 16개 동시 실행) 생성 중
# ZK 세션이 만료되며 master 가 죽는다. 실측 3회 전부 같은 지점에서 실패:
#   기본힙+CMS → 8개에서 정지 / 4G+CMS → 5개에서 사망 / 2G+ParallelGC → 5개에서 사망
# 힙·GC 를 바꿔도 결과가 같아 원인은 그 둘이 아니다(에뮬레이션 지연으로 추정).
# x86 홈서버에서는 재현되지 않을 것으로 보나 확인 전이다.
PINPOINT_HBASE_HEAPSIZE=2G
